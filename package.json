{
  "name": "verified",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "chain": "hardhat node --hostname 127.0.0.1",
    "compile": "hardhat compile",
    "demo:setup": "npm run compile && node scripts/deploy.js",
    "demo:reset": "node scripts/deploy.js --reset",
    "dev": "node scripts/dev.js",
    "api": "node --env-file-if-exists=.env server/index.js",
    "web": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "npm run compile && node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "express": "^5.3.0",
    "lucide-react": "^1.54.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "hardhat": "^3.19.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
